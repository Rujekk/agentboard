{
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.0",
    "@supabase/supabase-js": "^2.45.0"
  },
  "description": "TypeScript client & indexer for the AgentBoard program",
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "anchor-bankrun": "^0.5.0",
    "chai": "^4.3.4",
    "litesvm": "^1.6.2",
    "mocha": "^9.0.0",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "name": "agentboard-client",
  "private": true,
  "scripts": {
    "client": "ts-node src/index.ts",
    "indexer": "ts-node src/indexer.ts",
    "test:litesvm": "ts-mocha -p ./tsconfig.json -t 1000000 tests/agentboard.litesvm.ts",
    "test:bankrun": "SBF_OUT_DIR=$PWD/target/deploy-v1 ts-mocha -p ./tsconfig.json -t 1000000 tests/agentboard.bankrun.ts",
    "demo": "node scripts/demo.ts",
    "demo:devnet": "node scripts/demo.ts --cluster devnet"
  },
  "version": "0.1.0"
}